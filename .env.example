# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible endpoint. Works with OpenAI, OpenRouter, or a local server.
PINDOWN_API_KEY=sk-...
PINDOWN_BASE_URL=https://api.openai.com/v1

# Pin an exact model version. A floating alias makes runs unreproducible.
PINDOWN_MODEL=gpt-4.1-2025-04-14

# Set to 1 to run the whole pipeline with a canned agent and no API calls.
# The mutation engine, the quality filters and the eval harness are all
# fully exercisable this way, for free.
PINDOWN_STUB_LLM=0
